# ──────────────────────────────────────────────────────────────────────────────
# DealCraft configuration. Copy to .env.local (development) or set in your host.
# Never commit real values. Never put secrets in NEXT_PUBLIC_* variables.
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED — MongoDB Atlas connection string. Include the database name in the
# path, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/dealcraft?retryWrites=true&w=majority
# For a zero-setup local demo or tests you may use: memory://local
# (in-process store, wiped on restart, refused in production).
DATABASE_URL=memory://local

# REQUIRED in production — at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# REQUIRED in production — the public base URL (used for OAuth redirects,
# email links and same-origin checks). e.g. https://dealcraft.example.com
AUTH_URL=http://localhost:3000

# Google sign-in: 1 = enabled (requires the two values below), 0 = disabled.
# Authorised redirect URI in Google Cloud Console: ${AUTH_URL}/api/auth/google/callback
GOOGLE_AUTH_ENABLED=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI features: 1 = enabled, 0 = disabled (Classic mode always works).
# AI_PROVIDER: google | openai | anthropic | mock (mock = deterministic, no network)
AI_ENABLED=0
AI_PROVIDER=
AI_API_KEY=
# Optional per-task model overrides (sensible defaults per provider otherwise)
AI_MODEL_NEGOTIATION=
AI_MODEL_EVALUATION=
AI_MODEL_SCENARIO=

# Comma-separated emails that become ADMIN once their address is verified.
ADMIN_EMAILS=

# 1 = enforce rate limits (recommended), 0 = disable (local load testing only)
RATE_LIMIT_ENABLED=1

# Optional — outbound email via Resend for verification and password reset.
# Without it, development prints links to the server console; production
# shows that email-based reset is unavailable.
RESEND_API_KEY=
EMAIL_FROM=
